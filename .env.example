# The SAME database as the VoroniX CRM (apps/api). The AI tables are created
# inside each business schema t_<id>, next to clients and appointments.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
PORT=4100

# Who may call the API from a browser (the AI page). Comma separated, * = any.
CORS_ORIGINS=*

# Bookings the AI makes are written into CRM appointments too.
#   loose  : if the CRM refuses for a reason other than a busy slot, the booking
#            is kept for the AI and marked sync_status = failed
#   strict : any CRM refusal refuses the booking
#   off    : never touch CRM appointments
CRM_SYNC=loose

# How many days back CRM visits are sent to the AI (future ones are always sent).
CRM_DAYS_BACK=60

# Local development only: no API key, every request uses this business.
# Never set these on a public server.
ALLOW_NO_AUTH=false
DEFAULT_BUSINESS_ID=
