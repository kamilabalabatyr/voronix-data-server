{
  "name": "voronix-data",
  "version": "0.1.0",
  "private": true,
  "description": "VoroniX AI data server: stores what the AI knows (clients, their preferences, bookings, business knowledge, training data) in the CRM's own PostgreSQL database.",
  "type": "module",
  "main": "dist/src/app.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/cli/migrate.ts",
    "key:create": "tsx src/cli/keys.ts create",
    "key:list": "tsx src/cli/keys.ts list",
    "key:revoke": "tsx src/cli/keys.ts revoke",
    "test": "vitest run"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
